{
  "name": "@tethralinc/homebridge-tethral",
  "displayName": "Tethral",
  "type": "module",
  "version": "0.1.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Expose Tethral routines as HomeKit and Matter accessories via Homebridge",
  "author": "Tethral",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Tethral-Inc/homebridge-tethral#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tethral-Inc/homebridge-tethral.git"
  },
  "bugs": {
    "url": "https://github.com/Tethral-Inc/homebridge-tethral/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "tethral",
    "matter",
    "homekit",
    "smart-home"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "node --import tsx --test --test-reporter=spec test/tethralClient.test.ts test/platform.test.ts",
    "prepublishOnly": "npm run lint && npm run build && npm test",
    "watch": "npm run build && npm link && nodemon",
    "mock-api": "node --watch dev/mock-api/server.js",
    "mint-token": "node dev/mock-api/mint-token.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "bonjour-service": "^1.3.0",
    "eslint": "^10.3.0",
    "fastify": "^5.0.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
